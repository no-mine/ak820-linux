# Maintainer: no-mine <233317302+no-mine@users.noreply.github.com>
pkgname=ak820-linux
pkgver=0.1.0
pkgrel=1
pkgdesc='Configuration tool for the AJAZZ AK820 Pro keyboard (lighting, screen, clock)'
arch=('any')
url='https://github.com/no-mine/ak820-linux'
license=('MIT')
depends=('python' 'python-pillow' 'python-gobject' 'gtk4' 'libadwaita' 'systemd')
makedepends=('python-build' 'python-installer' 'python-setuptools' 'python-wheel')
# Local build (make arch) supplies this tarball itself. For the AUR use instead:
#   source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")   and a real sha256sum
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
    cd "$pkgname-$pkgver"
    python -m build --wheel --no-isolation
}

check() {
    cd "$pkgname-$pkgver"
    python -m unittest discover -s tests
}

package() {
    cd "$pkgname-$pkgver"
    python -m installer --destdir="$pkgdir" dist/*.whl
    install -Dm644 packaging/70-ak820.rules "$pkgdir/usr/lib/udev/rules.d/70-ak820.rules"
    install -Dm644 packaging/org.ak820linux.Configurator.desktop -t "$pkgdir/usr/share/applications/"
    install -Dm644 packaging/org.ak820linux.Configurator.svg -t "$pkgdir/usr/share/icons/hicolor/scalable/apps/"
    install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
}
